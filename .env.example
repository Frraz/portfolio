# URL pública, fixada no build (canonical, sitemap, compartilhamento)
SITE_URL=https://warley.ferzion.com.br
# Porta do contêiner no loopback do VPS
PORTA=8030
# Número em E.164, sem "+". Nunca vai para o código nem para os documentos.
WHATSAPP_NUMERO=

# Opcional: IP do servidor. Nunca vai ao site; o build só confere que ele não aparece na saída.
IP_SERVIDOR=
