    "@react-three/postprocessing": "^3.2.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "next": "^16.4.5",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/grenze-gotisch": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource/jacquard-24": "^5.3.0",
    "@fontsource/monomakh": "^5.3.0",
    "@fontsource/noto-sans-glagolitic": "^5.3.0",
