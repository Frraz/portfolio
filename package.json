{
  "name": "nave-digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm verificar",
    "build": "next build && tsx scripts/pos-build.ts",
    "start": "tsx scripts/servir.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "temas": "tsx scripts/gerar-temas.ts",
    "fontes": "tsx scripts/copiar-fontes.ts",
    "atlas": "tsx scripts/gerar-atlas.ts",
    "selos": "tsx scripts/gerar-selos.ts",
    "lottie": "tsx scripts/gerar-lottie.ts",
    "certificados": "python3 scripts/gerar-certificados.py",
    "verificar": "tsx scripts/verificar-contraste.ts && tsx scripts/verificar-conteudo.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:tudo": "pnpm verificar && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@gsap/react": "^2.1.2",
